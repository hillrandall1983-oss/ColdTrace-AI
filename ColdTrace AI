            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function importPlanJSON(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const importedPlan = JSON.parse(e.target.result);
                    if (!importedPlan.name || importedPlan.optimalLow === undefined || !Array.isArray(importedPlan.ranges)) {
                        throw new Error("Invalid compliance plan structure.");
                    }
                    let newKey = 'imported_' + Date.now();
                    compliancePlans[newKey] = importedPlan;
                    savePlansToStorage();
                    populatePlanDropdowns();
                    document.getElementById('modal-plan-select').value = newKey;
                    document.getElementById('plan-select').value = newKey;
                    loadPlanIntoModal();
                    evaluateCompliance();
                    alert(`Successfully imported compliance plan: "${importedPlan.name}"`);
                } catch(err) {
                    alert("Failed to import plan JSON: " + err.message);
                }
                event.target.value = '';
            };
            reader.readAsText(file);
        }

        function importAllPlansJSON(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const importedPlans = JSON.parse(e.target.result);
                    if (!importedPlans || typeof importedPlans !== 'object') {
                        throw new Error("Invalid compliance plans collection structure.");
                    }
                    
                    let importedCount = 0;
                    for (let k in importedPlans) {
                        let p = importedPlans[k];
                        if (p.name && p.optimalLow !== undefined && Array.isArray(p.ranges)) {
                            let targetKey = k.startsWith('custom_') || k.startsWith('imported_') ? k : 'plan_' + Date.now() + '_' + Math.floor(Math.random()*1000);
                            compliancePlans[targetKey] = p;
                            importedCount++;
                        }
                    }

                    if (importedCount === 0) {
                        throw new Error("No valid compliance plans found in imported file.");
                    }

                    savePlansToStorage();
                    populatePlanDropdowns();
                    loadPlanIntoModal();
                    evaluateCompliance();
                    alert(`Successfully imported ${importedCount} compliance plan(s).`);
                } catch(err) {
                    alert("Failed to import plans collection JSON: " + err.message);
                }
                event.target.value = '';
            };
            reader.readAsText(file);
        }

        function escapeHtml(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function drawTooltipBubble(ctx, x, y, text1, text2) {
            ctx.font = 'bold 13px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
            const w1 = ctx.measureText(text1).width;
            ctx.font = '11px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
            const w2 = ctx.measureText(text2).width;

            const boxWidth = Math.max(w1, w2) + 24;
            const boxHeight = 48;
            const radius = 8;
            const pointerSize = 6;

            let boxX = x - boxWidth / 2;
            let boxY = y - boxHeight - pointerSize - 6;

            if (boxX < 10) boxX = 10;
            if (boxX + boxWidth > ctx.canvas.width - 10) boxX = ctx.canvas.width - boxWidth - 10;
            if (boxY < 10) boxY = y + pointerSize + 12;

            ctx.shadowColor = 'rgba(0, 0, 0, 0.4)';
            ctx.shadowBlur = 8;
            ctx.shadowOffsetY = 3;

            ctx.fillStyle = '#3b82f6';
            ctx.beginPath();
            ctx.moveTo(boxX + radius, boxY);
            ctx.lineTo(boxX + boxWidth - radius, boxY);
            ctx.quadraticCurveTo(boxX + boxWidth, boxY, boxX + boxWidth, boxY + radius);
            ctx.lineTo(boxX + boxWidth, boxY + boxHeight - radius);
            ctx.quadraticCurveTo(boxX + boxWidth, boxY + boxHeight, boxX + boxWidth - radius, boxY + boxHeight);

            if (boxY < y) {
                ctx.lineTo(x + pointerSize, boxY + boxHeight);
                ctx.lineTo(x, boxY + boxHeight + pointerSize);
                ctx.lineTo(x - pointerSize, boxY + boxHeight);
            }
            ctx.lineTo(boxX + radius, boxY + boxHeight);
            ctx.quadraticCurveTo(boxX, boxY + boxHeight, boxX, boxY + boxHeight - radius);
            ctx.lineTo(boxX, boxY + radius);
            ctx.quadraticCurveTo(boxX, boxY, boxX + radius, boxY);
            ctx.closePath();
            ctx.fill();

            ctx.shadowColor = 'transparent';

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 13px sans-serif';
            ctx.fillText(text1, boxX + 12, boxY + 20);

            ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
            ctx.font = '11px sans-serif';
            ctx.fillText(text2, boxX + 12, boxY + 38);
        }

        function renderCanvasChart() {
            const canvas = document.getElementById('tempChart');
            const ctx = canvas.getContext('2d');

            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            if (fullRawData.length === 0) return;

            const padding = { top: 30, right: 30, bottom: 50, left: 50 };
            const graphWidth = canvas.width - padding.left - padding.right;
            const graphHeight = canvas.height - padding.top - padding.bottom;

            const minF = parseFloat(document.getElementById('graph-min-f').value) || 30;
            const maxF = parseFloat(document.getElementById('graph-max-f').value) || 80;

            const startTime = zoomState.startTimeMs || fullRawData[0].time.getTime();
            const endTime = zoomState.endTimeMs || fullRawData[fullRawData.length - 1].time.getTime();
            const timeSpan = endTime - startTime || 1;

            const getX = (t) => padding.left + ((t.getTime() - startTime) / timeSpan) * graphWidth;
            const getY = (temp) => padding.top + graphHeight - ((temp - minF) / (maxF - minF)) * graphHeight;

            const planKey = document.getElementById('plan-select').value;
            const plan = compliancePlans[planKey];
            
            let safeLow = plan && plan.optimalLow !== undefined ? plan.optimalLow : minF;
            let safeHigh = plan && plan.optimalHigh !== undefined ? plan.optimalHigh : maxF;

            const safeYTop = getY(safeHigh);
            const safeYBottom = getY(safeLow);
            ctx.fillStyle = 'rgba(74, 222, 128, 0.12)';
            ctx.fillRect(padding.left, Math.max(padding.top, safeYTop), graphWidth, Math.min(graphHeight, Math.max(1, safeYBottom - safeYTop)));

            ctx.fillStyle = '#4ade80';
            ctx.font = 'bold 11px sans-serif';
            ctx.fillText(`TARGET SAFE ZONE (${safeLow.toFixed(1)}°F - ${safeHigh.toFixed(1)}°F)`, padding.left + 10, Math.max(padding.top + 15, safeYTop + 16));

            ctx.strokeStyle = '#334155';
            ctx.lineWidth = 1;
            ctx.fillStyle = '#94a3b8';
            ctx.font = '10px sans-serif';

            const stepF = (maxF - minF) / 6;
            for (let i = 0; i <= 6; i++) {
                let val = minF + (stepF * i);
                let y = getY(val);
                ctx.beginPath();
                ctx.moveTo(padding.left, y);
                ctx.lineTo(canvas.width - padding.right, y);
                ctx.stroke();

                ctx.fillText(`${Math.round(val)}°F`, 10, y + 3);
            }

            ctx.save();
            ctx.beginPath();
            ctx.rect(padding.left, padding.top, graphWidth, graphHeight);
            ctx.clip();

            ctx.strokeStyle = '#38bdf8';
            ctx.lineWidth = 2;
            ctx.beginPath();

            let drawing = false;
            let pointPositions = [];

            fullRawData.forEach((d) => {
                let x = getX(d.time);
                let y = getY(d.temp);

                if (x >= padding.left - 50 && x <= canvas.width - padding.right + 50) {
                    pointPositions.push({ x, y, data: d });
                    if (!drawing) { ctx.moveTo(x, y); drawing = true; }
                    else ctx.lineTo(x, y);
                }
            });
            ctx.stroke();
            ctx.restore();

            if (mouseState.hovering && !zoomState.isDragging && pointPositions.length > 0) {
                let nearestPoint = null;
                let minDist = Infinity;

                pointPositions.forEach(p => {
                    let dist = Math.abs(p.x - mouseState.x);
                    if (dist < minDist) {
                        minDist = dist;
                        nearestPoint = p;
                    }
                });

                if (nearestPoint && mouseState.x >= padding.left && mouseState.x <= canvas.width - padding.right) {
                    ctx.strokeStyle = 'rgba(148, 163, 184, 0.7)';
                    ctx.lineWidth = 1;
                    ctx.setLineDash([4, 4]);
                    ctx.beginPath();
                    ctx.moveTo(nearestPoint.x, padding.top);
                    ctx.lineTo(nearestPoint.x, canvas.height - padding.bottom);
                    ctx.stroke();
                    ctx.setLineDash([]);

                    ctx.fillStyle = 'rgba(59, 130, 246, 0.25)';
                    ctx.beginPath();
                    ctx.arc(nearestPoint.x, nearestPoint.y, 9, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.fillStyle = '#2563eb';
                    ctx.strokeStyle = '#ffffff';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.arc(nearestPoint.x, nearestPoint.y, 5, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();

                    let tempStr = `${nearestPoint.data.temp.toFixed(2)}°F`;
                    let monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                    let monthStr = monthNames[nearestPoint.data.time.getMonth()];
                    let dayStr = nearestPoint.data.time.getDate();
                    let hours = nearestPoint.data.time.getHours();
                    let minutes = nearestPoint.data.time.getMinutes().toString().padStart(2, '0');
                    let ampm = hours >= 12 ? 'PM' : 'AM';
                    hours = hours % 12 || 12;
                    let timeFormatted = `${monthStr} ${dayStr} - ${hours.toString().padStart(2, '0')}:${minutes} ${ampm}`;

                    drawTooltipBubble(ctx, nearestPoint.x, nearestPoint.y, tempStr, timeFormatted);
                }
            }

            if (zoomState.isDragging) {
                ctx.fillStyle = 'rgba(56, 189, 248, 0.25)';
                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 1;
                ctx.setLineDash([4, 4]);
                let boxX = Math.min(zoomState.dragStartX, zoomState.dragCurrentX);
                let boxWidth = Math.abs(zoomState.dragCurrentX - zoomState.dragStartX);
                ctx.fillRect(boxX, padding.top, boxWidth, graphHeight);
                ctx.strokeRect(boxX, padding.top, boxWidth, graphHeight);
                ctx.setLineDash([]);
            }

            const tickCount = 5;
            for (let i = 0; i <= tickCount; i++) {
                let t = new Date(startTime + (timeSpan * (i / tickCount)));
                let x = padding.left + (graphWidth * (i / tickCount));

                let month = (t.getMonth() + 1).toString().padStart(2, '0');
                let day = t.getDate().toString().padStart(2, '0');

                let hours = t.getHours();
                let minutes = t.getMinutes().toString().padStart(2, '0');
                let ampm = hours >= 12 ? 'PM' : 'AM';
                hours = hours % 12;
                hours = hours ? hours : 12;

                let dateStr = `${month}/${day}/${t.getFullYear()}`;
                let timeStr = `${hours}:${minutes} ${ampm}`;

                ctx.fillStyle = '#94a3b8';
                ctx.fillText(dateStr, x - 28, canvas.height - 22);
                ctx.fillText(timeStr, x - 22, canvas.height - 8);

                ctx.beginPath();
                ctx.moveTo(x, canvas.height - padding.bottom);
                ctx.lineTo(x, canvas.height - padding.bottom + 5);
                ctx.stroke();
            }
        }

        function openPlanModal() {
            document.getElementById('plan-modal').style.display = 'flex';
            loadPlanIntoModal();
        }

        function closePlanModal() {
            document.getElementById('plan-modal').style.display = 'none';
        }

        function loadPlanIntoModal() {
            const key = document.getElementById('modal-plan-select').value;
            const plan = compliancePlans[key];
            if (!plan) return;

            document.getElementById('modal-plan-name').value = plan.name;
            document.getElementById('modal-optimal-low').value = plan.optimalLow !== undefined ? plan.optimalLow : -25.0;
            document.getElementById('modal-optimal-high').value = plan.optimalHigh !== undefined ? plan.optimalHigh : 25.0;

            const container = document.getElementById('modal-tiers-container');
            container.innerHTML = '';

            plan.ranges.forEach(r => {
                addModalTierRow(r.low, r.high, r.allowed, r.type);
            });
        }

        function createNewPlan() {
            let planName = prompt("Enter a name for the new compliance plan:");
            if (!planName || !planName.trim()) return;

            let planKey = 'custom_' + Date.now();
            compliancePlans[planKey] = {
                name: planName.trim(),
                optimalLow: -10.0,
                optimalHigh: 10.0,
                ranges: [
                    { low: 10.1, high: 30.0, allowed: 120, type: 'warm' }
                ]
            };

            savePlansToStorage();
            populatePlanDropdowns();
            
            document.getElementById('modal-plan-select').value = planKey;
            loadPlanIntoModal();
        }

        function deleteCurrentPlan() {
            const select = document.getElementById('modal-plan-select');
            const key = select.value;
            const planKeys = Object.keys(compliancePlans);

            if (planKeys.length <= 1) {
                alert("You must keep at least one compliance plan in the system.");
                return;
            }

            const planName = compliancePlans[key] ? compliancePlans[key].name : key;
            if (!confirm(`Are you sure you want to delete the plan "${planName}"?`)) {
                return;
            }

            delete compliancePlans[key];
            savePlansToStorage();
            populatePlanDropdowns();

            const remainingKeys = Object.keys(compliancePlans);
            if (remainingKeys.length > 0) {
                select.value = remainingKeys[0];
                document.getElementById('plan-select').value = remainingKeys[0];
                loadPlanIntoModal();
            }

            evaluateCompliance();
        }

        function addModalTierRow(low = 0, high = 0, allowed = 60, type = 'warm') {
            const container = document.getElementById('modal-tiers-container');
            const div = document.createElement('div');
            div.className = 'tier-row';
            div.innerHTML = `
                <input type="number" step="0.1" value="${low}" style="width: 70px;" placeholder="Low °F">
                <span>to</span>
                <input type="number" step="0.1" value="${high}" style="width: 70px;" placeholder="High °F">
                <input type="number" value="${allowed}" style="width: 80px;" placeholder="Mins">
                <select style="width: 80px;">
                    <option value="warm" ${type === 'warm' ? 'selected' : ''}>Warm</option>
                    <option value="cold" ${type === 'cold' ? 'selected' : ''}>Cold</option>
                </select>
                <button onclick="this.parentElement.remove()" style="color:#f87171; border:none; background:none; cursor:pointer;">✕</button>
            `;
            container.appendChild(div);
        }

        function savePlanFromModal() {
            const key = document.getElementById('modal-plan-select').value;
            const name = document.getElementById('modal-plan-name').value;
            const optimalLow = parseFloat(document.getElementById('modal-optimal-low').value);
            const optimalHigh = parseFloat(document.getElementById('modal-optimal-high').value);
            const rows = document.querySelectorAll('#modal-tiers-container .tier-row');

            if (isNaN(optimalLow) || isNaN(optimalHigh)) {
                alert("Temperature bounds must be valid numbers.");
                return;
            }

            let ranges = [];
            let isValid = true;
            rows.forEach(r => {
                let inputs = r.querySelectorAll('input');
                let select = r.querySelector('select');
                let lowVal = parseFloat(inputs[0].value);
                let highVal = parseFloat(inputs[1].value);
                let allowedVal = parseInt(inputs[2].value, 10);

                if (isNaN(lowVal) || isNaN(highVal) || isNaN(allowedVal)) {
                    isValid = false;
                }
                ranges.push({
                    low: lowVal,
                    high: highVal,
                    allowed: allowedVal,
                    type: select.value
                });
            });

            if (!isValid) {
                alert("All tier fields must be filled out with valid numbers before saving.");
                return;
            }

            compliancePlans[key] = { name, optimalLow, optimalHigh, ranges };
            savePlansToStorage();
            populatePlanDropdowns();
            document.getElementById('plan-select').value = key;
            closePlanModal();
            evaluateCompliance();
        }
    </script>
