        function processRawText(text) {
            const lines = text.split(/\r?\n/);
            let parsedRows = [];
            let profile = document.getElementById('logger-profile-select').value;

            let isCargoData = (profile === 'cargodata_lightning' || text.includes('Cargo Data') || text.includes('P.O.#') || text.toLowerCase().includes('inspector'));
            let isTempTale = (profile === 'temptale' || text.includes('TempTale') || text.includes('Sensitech') || text.includes('Primary ( F)'));

            // 1. Cargo Data Lightning NFC parser
            if (isCargoData && !isTempTale) {
                let timeColIdx = -1;
                let tempColIdx = -1;

                for (let line of lines) {
                    if (!line.trim()) continue;
                    let parts = parseCSVLine(line);
                    let lowerLine = line.toLowerCase();

                    if (timeColIdx === -1 && (lowerLine.includes('date/time') || lowerLine.includes('date / time') || lowerLine.includes('timestamp'))) {
                        for (let i = 0; i < parts.length; i++) {
                            let p = parts[i].toLowerCase();
                            if (p.includes('date') || p.includes('time') || p.includes('timestamp')) {
                                timeColIdx = i;
                            }
                            if (p.includes('temp') || p.includes('f') || p.includes('c')) {
                                tempColIdx = i;
                            }
                        }
                        continue;
                    }

                    if (timeColIdx !== -1 && tempColIdx !== -1 && parts.length > Math.max(timeColIdx, tempColIdx)) {
                        let t = parseLoggerTimestamp(parts[timeColIdx]);
                        let tempVal = parseFloat(parts[tempColIdx].replace(/[^-\d.]/g, ''));

                        if (t && !isNaN(tempVal) && tempVal >= -100 && tempVal <= 150) {
                            parsedRows.push({ time: t, temp: tempVal });
                        }
                    }
                }
            }

            // 2. Sensitech TempTale4 tabular parser
            if (parsedRows.length === 0 && (isTempTale || text.includes('Primary ( F)'))) {
                let timeColIdx = -1;
                let tempColIdx = -1;

                for (let line of lines) {
                    if (!line.trim()) continue;
                    let parts = parseCSVLine(line);
                    let lowerLine = line.toLowerCase();

                    if (timeColIdx === -1 && (lowerLine.includes('date') || lowerLine.includes('time') || lowerLine.includes('timestamp'))) {
                        for (let i = 0; i < parts.length; i++) {
                            let p = parts[i].toLowerCase();
                            if (p.includes('date') || p.includes('time') || p.includes('timestamp')) {
                                timeColIdx = i;
                            }
                            if (p.includes('temp') || p.includes('primary') || p.includes('ambient') || p.includes('f')) {
                                tempColIdx = i;
                            }
                        }
                        if (timeColIdx !== -1 && tempColIdx === -1) tempColIdx = 2;
                        continue;
                    }

                    if (timeColIdx !== -1 && tempColIdx !== -1 && parts.length > Math.max(timeColIdx, tempColIdx)) {
                        let t = parseLoggerTimestamp(parts[timeColIdx]);
                        let tempVal = parseFloat(parts[tempColIdx].replace(/[^-\d.]/g, ''));

                        if (t && !isNaN(tempVal) && tempVal >= -100 && tempVal <= 150) {
                            parsedRows.push({ time: t, temp: tempVal });
                        }
                    }
                }
            }

            // 3. Fallback generic parser
            if (parsedRows.length === 0) {
                for (let line of lines) {
                    if (!line.trim()) continue;
                    let cleanLine = line.replace(/\x00/g, '').trim();
                    let parts = parseCSVLine(cleanLine);

                    let timeVal = null;
                    let tempVal = null;

                    for (let i = 0; i < parts.length; i++) {
                        let t = parseLoggerTimestamp(parts[i]);
                        if (t) {
                            timeVal = t;
                            break;
                        }
                    }

                    for (let i = 1; i < parts.length; i++) {
                        let rawToken = parts[i];
                        let cleanToken = rawToken.replace(/[^-\d.]/g, '');
                        let num = parseFloat(cleanToken);
                        if (!isNaN(num) && num >= -100 && num <= 150 && cleanToken !== '') {
                            if (cleanToken.includes('.') || Math.abs(num) > 50 || parts.length <= 3) {
                                tempVal = num;
                                break;
                            }
                        }
                    }

                    if (timeVal && tempVal !== null) {
                        parsedRows.push({ time: timeVal, temp: tempVal });
                    }
                }
            }

            if (parsedRows.length === 0) {
                alert("No valid timestamp and temperature data found in the file using the selected hardware profile.");
                return;
            }

            parsedRows.sort((a, b) => a.time - b.time);
            fullRawData = parsedRows;
            
            initFilterBounds();
            adjustGraphScaleToData();
            evaluateCompliance();
        }

        function initFilterBounds() {
            if (fullRawData.length === 0) return;
            const start = fullRawData[0].time;
            const end = fullRawData[fullRawData.length - 1].time;

            document.getElementById('filter-start').value = formatDateForInput(start);
            document.getElementById('filter-end').value = formatDateForInput(end);
            
            filteredData = [...fullRawData];
            zoomState.startTimeMs = start.getTime();
            zoomState.endTimeMs = end.getTime();
