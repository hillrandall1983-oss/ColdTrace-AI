                <p><strong>Duration:</strong> ${(totalElapsedMinutes / 60).toFixed(1)} hrs</p>
                <p><strong>Min Temp:</strong> ${minTemp} °F</p>
                <p><strong>Max Temp:</strong> ${maxTemp} °F</p>
                <p><strong>Avg Temp:</strong> ${avgTemp} °F</p>
                ${dataGapMinutes > 0 ? `<p style="color: #f87171;">⚠️ <strong>Data Gaps Detected:</strong> ${(dataGapMinutes/60).toFixed(1)} hrs</p>` : ''}
            `;

            document.getElementById('audit-insight-box').innerHTML = `
                <strong>Compliance Plan:</strong> ${escapeHtml(plan.name)} (Optimal: ${plan.optimalLow}°F to ${plan.optimalHigh}°F)<br>
                <strong>Receiving Dock Disposition:</strong> <span style="font-weight:bold; color: ${overallPass ? '#4ade80' : '#f87171'};">${overallPass ? 'ACCEPTED (PASS)' : 'REJECTED (FAIL)'}</span><br>
                <strong>Max Tier Utilization:</strong> ${maxUtilizationPct.toFixed(1)}%<br>
                <strong>Cumulative Tier Utilization Total:</strong> ${cumulativeUtilizationSum.toFixed(1)}% (Fail Threshold: ≥ 101.0%)<br>
                <strong>Target Safe Zone Share:</strong> ${targetZonePct}% of duration<br>
                ${unclassifiedMinutes > 0 ? `<span style="color: #94a3b8; font-size: 0.85rem;">(Note: ${Math.round(unclassifiedMinutes)} mins logged outside optimal range and defined tiers)</span>` : ''}
            `;

            const tbody = document.querySelector('#exposure-table tbody');
            tbody.innerHTML = '';

            tierExposures.forEach(tier => {
                const tr = document.createElement('tr');
                const isBreached = tier.utilizationPct >= 100.0 || tier.elapsedMinutes > tier.allowed;
                
                let utilColorClass = 'util-green';
                if (tier.utilizationPct >= 100.0) utilColorClass = 'util-red';
                else if (tier.utilizationPct >= 75.0) utilColorClass = 'util-yellow';

                tr.innerHTML = `
                    <td>${tier.low.toFixed(1)}°F to ${tier.high > 900 ? '∞' : tier.high.toFixed(1) + '°F'}</td>
                    <td><span style="text-transform: capitalize;">${escapeHtml(tier.type)}</span> Excursion</td>
                    <td>${tier.allowed} mins (${(tier.allowed / 60).toFixed(1)} hrs)</td>
                    <td><strong>${Math.round(tier.elapsedMinutes)} mins</strong> (${(tier.elapsedMinutes / 60).toFixed(1)} hrs)</td>
                    <td><span class="util-badge ${utilColorClass}">${tier.utilizationPct.toFixed(1)}%</span></td>
                    <td><span class="status-badge ${isBreached ? 'status-fail' : 'status-pass'}">${isBreached ? 'FAIL' : 'PASS'}</span></td>
                `;
                tbody.appendChild(tr);
            });

            let totalColorClass = 'util-green';
            if (cumulativeUtilizationSum >= 101.0) totalColorClass = 'util-red';
            else if (cumulativeUtilizationSum >= 75.0) totalColorClass = 'util-yellow';

            const totalTr = document.createElement('tr');
            totalTr.className = 'table-total-row';
            totalTr.innerHTML = `
                <td colspan="4" style="text-align: right;">Total Cumulative Tier Utilization:</td>
                <td><span class="util-badge ${totalColorClass}">${cumulativeUtilizationSum.toFixed(1)}%</span></td>
                <td><span class="status-badge ${overallPass ? 'status-pass' : 'status-fail'}">${overallPass ? 'PASS' : 'FAIL'}</span></td>
            `;
            tbody.appendChild(totalTr);
        }

