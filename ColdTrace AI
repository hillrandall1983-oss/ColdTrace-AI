        function initCanvasInteractiveEvents() {
            const canvas = document.getElementById('tempChart');

            canvas.addEventListener('wheel', (e) => {
                if (filteredData.length === 0 || !zoomState.startTimeMs) return;
                e.preventDefault();

                const factor = e.deltaY < 0 ? 0.85 : 1.15;
                zoomGraph(factor);
            }, { passive: false });

            canvas.addEventListener('mousedown', (e) => {
                if (fullRawData.length === 0) return;
                const rect = canvas.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const paddingLeft = 50;
                const paddingRight = 30;
                
                if (x >= paddingLeft && x <= canvas.width - paddingRight) {
                    zoomState.isDragging = true;
                    zoomState.dragStartX = x;
                    zoomState.dragCurrentX = x;
                }
            });

            canvas.addEventListener('mousemove', (e) => {
                const rect = canvas.getBoundingClientRect();
                mouseState.x = e.clientX - rect.left;
                mouseState.y = e.clientY - rect.top;
                mouseState.hovering = true;

                if (zoomState.isDragging) {
                    zoomState.dragCurrentX = Math.max(50, Math.min(mouseState.x, canvas.width - 30));
                }
                renderCanvasChart();
            });

            canvas.addEventListener('mouseleave', () => {
                mouseState.hovering = false;
                renderCanvasChart();
            });

            window.addEventListener('mouseup', (e) => {
                if (!zoomState.isDragging) return;
                zoomState.isDragging = false;

                const rect = canvas.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const x1 = Math.min(zoomState.dragStartX, x);
                const x2 = Math.max(zoomState.dragStartX, x);

                const paddingLeft = 50;
                const paddingRight = 30;
                const graphWidth = canvas.width - paddingLeft - paddingRight;

                if (x2 - x1 > 15 && graphWidth > 0) {
                    const startTime = zoomState.startTimeMs;
                    const endTime = zoomState.endTimeMs;
                    const timeSpan = endTime - startTime;

                    const newStartTime = startTime + ((x1 - paddingLeft) / graphWidth) * timeSpan;
                    const newEndTime = startTime + ((x2 - paddingLeft) / graphWidth) * timeSpan;

                    zoomState.startTimeMs = newStartTime;
                    zoomState.endTimeMs = newEndTime;

                    const newStartDate = new Date(newStartTime);
                    const newEndDate = new Date(newEndTime);

                    document.getElementById('filter-start').value = formatDateForInput(newStartDate);
                    document.getElementById('filter-end').value = formatDateForInput(newEndDate);

                    filteredData = fullRawData.filter(d => d.time >= newStartDate && d.time <= newEndDate);
                    evaluateCompliance();
                } else {
                    renderCanvasChart();
                }
            });
        }

        function zoomGraph(factor) {
            if (!zoomState.startTimeMs || !zoomState.endTimeMs) return;

            const center = (zoomState.startTimeMs + zoomState.endTimeMs) / 2;
            const halfSpan = ((zoomState.endTimeMs - zoomState.startTimeMs) / 2) * factor;

            if (halfSpan * 2 < 120000 && factor < 1) return;

            zoomState.startTimeMs = center - halfSpan;
            zoomState.endTimeMs = center + halfSpan;

            renderCanvasChart();
        }

        function resetZoom() {
            if (fullRawData.length === 0) return;
            zoomState.startTimeMs = fullRawData[0].time.getTime();
            zoomState.endTimeMs = fullRawData[fullRawData.length - 1].time.getTime();
            initFilterBounds();
            applyFilterWindow();
        }

        function evaluateCompliance() {
            if (filteredData.length === 0) return;

            const planKey = document.getElementById('plan-select').value;
            const plan = compliancePlans[planKey];
            if (!plan) return;

            let tierExposures = plan.ranges.map(r => ({ ...r, elapsedMinutes: 0 }));
            let targetZoneMinutes = 0;
            let unclassifiedMinutes = 0;
            let dataGapMinutes = 0;
            let totalElapsedMinutes = 0;

            const optLow = plan.optimalLow !== undefined ? plan.optimalLow : -999;
            const optHigh = plan.optimalHigh !== undefined ? plan.optimalHigh : 999;

            for (let i = 0; i < filteredData.length - 1; i++) {
                let current = filteredData[i];
                let next = filteredData[i + 1];
                let deltaMinutes = (next.time - current.time) / 60000;

                if (deltaMinutes > 120) {
                    dataGapMinutes += deltaMinutes;
                }

                totalElapsedMinutes += deltaMinutes;

                if (current.temp >= optLow && current.temp <= optHigh) {
                    targetZoneMinutes += deltaMinutes;
                } else {
                    let matchedTier = false;
                    for (let tier of tierExposures) {
                        if (current.temp >= tier.low && current.temp <= tier.high) {
                            tier.elapsedMinutes += deltaMinutes;
                            matchedTier = true;
                            break;
                        }
                    }
                    if (!matchedTier) {
                        unclassifiedMinutes += deltaMinutes;
                    }
                }
            }

            let overallPass = true;
            let maxUtilizationPct = 0;
            let cumulativeUtilizationSum = 0;

            tierExposures.forEach(tier => {
                tier.utilizationPct = (tier.elapsedMinutes / tier.allowed) * 100;
                cumulativeUtilizationSum += tier.utilizationPct;
                if (tier.utilizationPct > maxUtilizationPct) {
                    maxUtilizationPct = tier.utilizationPct;
                }
                if (tier.utilizationPct >= 100.0 || tier.elapsedMinutes > tier.allowed) {
                    overallPass = false;
                }
            });

            if (cumulativeUtilizationSum >= 101.0) {
                overallPass = false;
            }

            const targetZonePct = totalElapsedMinutes > 0 ? ((targetZoneMinutes / totalElapsedMinutes) * 100).toFixed(1) : 0;

            lastEvaluationResult = {
                plan,
                overallPass,
                tierExposures,
                targetZonePct,
                maxUtilizationPct,
                cumulativeUtilizationSum,
                unclassifiedMinutes,
                dataGapMinutes,
                totalElapsedMinutes
            };

            updateUIResults(lastEvaluationResult);
            renderCanvasChart();
        }

        function updateUIResults(res) {
            const { plan, overallPass, tierExposures, targetZonePct, maxUtilizationPct, cumulativeUtilizationSum, unclassifiedMinutes, dataGapMinutes, totalElapsedMinutes } = res;
            
            const badge = document.getElementById('disposition-badge');
            badge.style.display = 'inline-block';
            badge.innerText = overallPass ? 'PASS' : 'FAIL';
            badge.className = 'status-badge ' + (overallPass ? 'status-pass' : 'status-fail');

            const minTemp = Math.min(...filteredData.map(d => d.temp)).toFixed(1);
            const maxTemp = Math.max(...filteredData.map(d => d.temp)).toFixed(1);
            const avgTemp = (filteredData.reduce((s, d) => s + d.temp, 0) / filteredData.length).toFixed(1);

            document.getElementById('summary-content').innerHTML = `
                <p><strong>File:</strong> ${escapeHtml(activeFilename)}</p>
