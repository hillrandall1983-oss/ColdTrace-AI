        function parseLoggerTimestamp(str) {
            if (!str) return null;
            let cleaned = String(str).trim().replace(/^['"]|['"]$/g, '');
            if (cleaned.startsWith('="') && cleaned.endsWith('"')) {
                cleaned = cleaned.slice(2, -1);
            }
            
            let d = new Date(cleaned);
            if (!isNaN(d.getTime()) && d.getFullYear() > 2005 && d.getFullYear() < 2035) {
                return d;
            }

            let parts = cleaned.match(/(\d{1,4})[\/\-\.](\d{1,2})[\/\-\.](\d{1,4})[\sT]+(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(AM|PM)?/i);
            if (parts) {
                let p1 = parseInt(parts[1], 10), p2 = parseInt(parts[2], 10), p3 = parseInt(parts[3], 10);
                let hrs = parseInt(parts[4], 10), mins = parseInt(parts[5], 10), secs = parts[6] ? parseInt(parts[6], 10) : 0;
                let ampm = parts[7];

                if (ampm) {
                    if (ampm.toUpperCase() === 'PM' && hrs < 12) hrs += 12;
                    if (ampm.toUpperCase() === 'AM' && hrs === 12) hrs = 0;
                }

                let year, month, day;
                let profile = document.getElementById('logger-profile-select').value;
                let isCryopak = (profile === 'cryopak');

                if (p1 > 2000) { 
                    year = p1; month = p2 - 1; day = p3; 
                } else if (p3 > 2000) { 
                    year = p3; 
                    if (isCryopak || p1 > 12) {
                        day = p1; month = p2 - 1;
                    } else {
                        month = p1 - 1; day = p2;
                    }
                } else { 
                    return null; 
                }

                if (year > 2035 || year < 2020) return null;

                let parsedDate = new Date(year, month, day, hrs, mins, secs);
                if (!isNaN(parsedDate.getTime())) {
                    return parsedDate;
                }
            }
            return null;
        }

        function parseCSVLine(textLine) {
            let result = [];
            let current = '';
            let inQuotes = false;
            for (let i = 0; i < textLine.length; i++) {
                let c = textLine[i];
                if (c === '"') {
                    inQuotes = !inQuotes;
                } else if (c === ',' && !inQuotes) {
                    result.push(current.trim());
                    current = '';
                } else {
                    current += c;
                }
            }
            result.push(current.trim());
            return result;
        }

        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            activeFilename = file.name;
            document.getElementById('active-filename-display').innerText = `Continuous Temperature Trend Line (${activeFilename})`;

            const reader = new FileReader();
            const ext = file.name.split('.').pop().toLowerCase();

            if (ext === 'xlsx' || ext === 'xls') {
                reader.onload = function(e) {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                    const csvText = XLSX.utils.sheet_to_csv(firstSheet);
                    processRawText(csvText);
                };
                reader.readAsArrayBuffer(file);
            } else if (ext === 'pdf') {
                reader.onload = function(e) {
                    const typedarray = new Uint8Array(e.target.result);
                    pdfjsLib.getDocument(typedarray).promise.then(pdf => {
                        let maxPages = pdf.numPages;
                        let pagePromises = [];
                        for (let j = 1; j <= maxPages; j++) {
                            pagePromises.push(
                                pdf.getPage(j).then(page => {
                                    return page.getTextContent().then(textContent => {
                                        let rowsMap = {};
                                        textContent.items.forEach(item => {
                                            let y = Math.round(item.transform[5] / 5) * 5;
                                            if (!rowsMap[y]) rowsMap[y] = [];
                                            rowsMap[y].push({ x: item.transform[4], str: item.str });
                                        });
                                        let sortedYs = Object.keys(rowsMap).sort((a, b) => b - a);
                                        let pageLines = sortedYs.map(y => {
                                            rowsMap[y].sort((a, b) => a.x - b.x);
                                            return rowsMap[y].map(i => i.str).join(' ');
                                        });
                                        return pageLines.join('\n');
                                    });
                                })
                            );
                        }
                        Promise.all(pagePromises).then(pagesText => {
                            let fullText = pagesText.join('\n');
                            processRawText(fullText);
                        });
                    }).catch(err => {
                        alert("Error reading PDF file: " + err.message);
                    });
                };
                reader.readAsArrayBuffer(file);
            } else {
                reader.onload = function(e) {
                    processRawText(e.target.result);
                };
                reader.readAsText(file);
            }
        }

        function handlePasteInput() {
            const text = document.getElementById('paste-input').value;
            if (text.trim().length > 0) {
                activeFilename = "Pasted Data Stream";
