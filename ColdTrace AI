        function formatDateForInput(date) {
            const pad = (n) => n.toString().padStart(2, '0');
            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
        }

        function adjustGraphScaleToData() {
            if (fullRawData.length === 0) return;
            let min = Math.min(...fullRawData.map(d => d.temp));
            let max = Math.max(...fullRawData.map(d => d.temp));

            document.getElementById('graph-min-f').value = Math.floor(min - 5);
