<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ColdTrace AI — Enterprise Inbound Cold Chain Inspector</title>
    <!-- SheetJS from official CDN -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
    <!-- PDF.js for PDF text extraction -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
    </script>
    <style>
        :root {
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --bg-dark: #0f172a;
            --bg-card: #1e293b;
            --border-color: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --pass-bg: rgba(22, 101, 52, 0.3);
            --pass-text: #4ade80;
            --fail-bg: rgba(153, 27, 27, 0.3);
            --fail-text: #f87171;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            padding: 24px;
            max-width: 1400px;
            margin: 0 auto;
        }

        header {
            margin-bottom: 24px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        h1 {
            font-size: 1.75rem;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-top: 4px;
            font-style: italic;
        }

        .grid-container {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 24px;
        }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
            margin-bottom: 20px;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: var(--text-main);
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        select, input[type="file"], input[type="datetime-local"], input[type="number"], textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 0.9rem;
            background-color: #0f172a;
            color: var(--text-main);
        }

        input[type="file"]::file-selector-button {
            background: var(--border-color);
            color: var(--text-main);
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            margin-right: 10px;
        }

        .btn {
            background: var(--primary);
            color: #0f172a;
            border: none;
            padding: 10px 16px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.15s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn:hover {
            background: var(--primary-hover);
        }

        .btn-secondary {
            background: var(--border-color);
            color: var(--text-main);
        }

        .btn-secondary:hover {
            background: #475569;
        }

        .btn-danger {
            background: rgba(153, 27, 27, 0.4);
            color: #fca5a5;
            border: 1px solid #7f1d1d;
        }

        .btn-danger:hover {
            background: rgba(153, 27, 27, 0.7);
        }

        .btn-reset {
            background: rgba(153, 27, 27, 0.4);
            color: #fca5a5;
            border: 1px solid #7f1d1d;
            width: 100%;
            margin-top: 12px;
        }

        .btn-reset:hover {
            background: rgba(153, 27, 27, 0.7);
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .status-pass {
            background: var(--pass-bg);
            color: var(--pass-text);
            border: 1px solid rgba(74, 222, 128, 0.3);
        }

        .status-fail {
            background: var(--fail-bg);
            color: var(--fail-text);
            border: 1px solid rgba(248, 113, 113, 0.3);
        }

        .chart-controls {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 12px;
            flex-wrap: wrap;
            background: #0f172a;
            padding: 12px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
        }

        .chart-controls div {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .chart-controls input {
            width: auto;
            padding: 6px 8px;
        }

        .zoom-toolbar {
            display: flex;
            gap: 8px;
            margin-bottom: 8px;
            align-items: center;
        }

        .btn-zoom {
            padding: 4px 10px;
            font-size: 0.8rem;
            background: var(--border-color);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            color: var(--text-main);
        }

        .btn-zoom:hover {
            background: #475569;
        }

        canvas {
            width: 100%;
            height: 380px;
            background: #0f172a;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            cursor: crosshair;
            user-select: none;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
            margin-top: 8px;
        }

        th, td {
            text-align: left;
            padding: 10px 12px;
            border-bottom: 1px solid var(--border-color);
        }

        th {
            background: #0f172a;
            color: var(--text-muted);
            font-weight: 600;
        }

        .table-total-row {
            background: #0f172a;
            font-weight: 700;
            border-top: 2px solid var(--border-color);
        }

        .util-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: 700;
            display: inline-block;
        }
        .util-green { background: rgba(22, 101, 52, 0.3); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.3); }
        .util-yellow { background: rgba(133, 77, 14, 0.3); color: #facc15; border: 1px solid rgba(250, 204, 21, 0.3); }
        .util-red { background: rgba(153, 27, 27, 0.3); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.3); }

        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.8);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 24px;
            border-radius: 8px;
            width: 580px;
            max-width: 90vw;
            max-height: 85vh;
            overflow-y: auto;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .tier-row {
            display: flex;
            gap: 8px;
            margin-bottom: 8px;
            align-items: center;
        }

        .tier-row input, .tier-row select {
            padding: 6px;
            background: #0f172a;
            color: var(--text-main);
            border: 1px solid var(--border-color);
        }

        .audit-box {
            background: rgba(2, 132, 199, 0.15);
            border-left: 4px solid var(--primary);
            padding: 14px;
            border-radius: 0 6px 6px 0;
            font-size: 0.9rem;
            line-height: 1.5;
            color: #7dd3fc;
            margin-top: 12px;
            border-top: 1px solid rgba(56, 189, 248, 0.2);
            border-right: 1px solid rgba(56, 189, 248, 0.2);
            border-bottom: 1px solid rgba(56, 189, 248, 0.2);
        }

        @media print {
            body { background: white; color: black; padding: 0; }
            aside, .chart-controls, .zoom-toolbar, header button, .btn { display: none !important; }
            .grid-container { display: block; }
            .card { border: none; box-shadow: none; padding: 0; margin-bottom: 20px; }
            .audit-box { background: #f0f9ff; color: #0369a1; border-left: 4px solid #0284c7; }
            table th { background: #f1f5f9; color: #334155; }
            table td, table th { border-color: #cbd5e1; }
        }
    </style>
</head>
<body>

    <header>
        <div>
            <h1>❄️ ColdTrace AI</h1>
            <div class="subtitle">Enterprise Inbound Cold Chain & Temp Logger Inspector</div>
        </div>
        <div>
            <button class="btn btn-secondary" onclick="exportInspectionReport()">🖨️ Export Inspection Report</button>
        </div>
    </header>

    <div class="grid-container">
        <!-- Sidebar Controls -->
        <aside>
            <div class="card">
                <div class="card-title">Data Ingestion</div>
                
                <div class="form-group">
                    <label>Select Compliance Plan</label>
                    <select id="plan-select" onchange="evaluateCompliance()"></select>
                    <button class="btn btn-secondary" style="margin-top: 8px; width: 100%; font-size: 0.8rem;" onclick="openPlanModal()">⚙️ Custom Plan Editor</button>
                </div>

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label style="margin:0;">Logger Hardware Profile</label>
                        <button class="btn btn-secondary" style="padding: 2px 6px; font-size: 0.75rem;" onclick="openProfileModal()">✏️ Edit Profiles</button>
                    </div>
                    <select id="logger-profile-select"></select>
                </div>

                <div class="form-group">
                    <label>Upload Logger File (CSV, LOG, TXT, JSON, XLSX, XLS, PDF)</label>
                    <input type="file" id="file-input" accept=".csv,.txt,.log,.json,.xlsx,.xls,.pdf" onchange="handleFileUpload(event)">
                </div>

                <div class="form-group">
                    <label>Or Paste Raw Logger Text</label>
                    <textarea id="paste-input" rows="5" placeholder="Paste timestamp and temp readings here..."></textarea>
                    <button class="btn btn-secondary" style="margin-top: 6px; width: 100%; font-size: 0.8rem;" onclick="handlePasteInput()">Process Pasted Data</button>
                </div>

                <button class="btn btn-reset" onclick="resetWorkspace()">🔄 Reset Workspace</button>
            </div>

            <div class="card">
                <div class="card-title">Analysis Summary</div>
                <div id="summary-content">
                    <p style="color: var(--text-muted); font-size: 0.9rem;">Upload or paste data to view log statistics.</p>
                </div>
            </div>
        </aside>

        <!-- Main Chart & Analysis Area -->
        <main>
            <div class="card">
                <div class="card-title">
                    <span id="active-filename-display">Continuous Temperature Trend Line</span>
                    <span id="disposition-badge" class="status-badge" style="display:none;">---</span>
                </div>

                <div class="chart-controls">
                    <div>
                        <label style="margin:0;">Start:</label>
                        <input type="datetime-local" id="filter-start">
                    </div>
                    <div>
                        <label style="margin:0;">End:</label>
                        <input type="datetime-local" id="filter-end">
                    </div>
                    <button class="btn" onclick="applyFilterWindow()" style="padding: 6px 12px; font-size: 0.85rem;">✓ Apply Filter Window</button>
                    <div style="margin-left: auto;">
                        <label style="margin:0;">Min °F:</label>
                        <input type="number" id="graph-min-f" value="30" style="width: 60px;">
                        <label style="margin:0; margin-left:6px;">Max °F:</label>
                        <input type="number" id="graph-max-f" value="80" style="width: 60px;">
                    </div>
                </div>

                <div class="zoom-toolbar">
                    <button class="btn-zoom" onclick="zoomGraph(1.2)">🔍 Zoom In (+)</button>
                    <button class="btn-zoom" onclick="zoomGraph(0.8)">🔍 Zoom Out (-)</button>
                    <button class="btn-zoom" onclick="resetZoom()">🔄 Reset Zoom</button>
                    <span style="font-size:0.75rem; color:var(--text-muted); margin-left:auto; align-self:center;">💡 Hover to inspect points | <b>Click & Drag</b> to zoom range</span>
                </div>

                <canvas id="tempChart"></canvas>
            </div>

            <!-- Compliance Audit Insight Section -->
            <div class="card">
                <div class="card-title">Compliance Audit Insights</div>
                <div id="audit-insight-box" class="audit-box">
                    Awaiting data upload to evaluate compliance against selected temperature plan.
                </div>
            </div>

            <!-- Exposure Table -->
            <div class="card">
                <div class="card-title">Multi-Tier Threshold Exposure Breakdown (Fail Threshold ≥ 101.0%)</div>
                <table id="exposure-table">
                    <thead>
                        <tr>
                            <th>Tier / Temperature Range</th>
                            <th>Tier Type</th>
                            <th>Allowed Limit</th>
                            <th>Actual Elapsed Exposure</th>
                            <th>Tier Utilization %</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted);">No log data evaluated yet.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <!-- Modal Editor for Custom Compliance Plans -->
    <div class="modal-overlay" id="plan-modal">
        <div class="modal">
            <div class="modal-header">
                <h3>Edit Compliance Plans</h3>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <button class="btn" onclick="createNewPlan()" style="padding: 4px 10px; font-size: 0.8rem;">➕ Create New Plan</button>
                    <button onclick="closePlanModal()" style="background:none; border:none; color: var(--text-main); font-size: 1.2rem; cursor:pointer;">✕</button>
                </div>
            </div>
            
            <div class="form-group" style="display: flex; gap: 8px; align-items: flex-end;">
                <div style="flex: 1; margin-bottom: 0;">
                    <label>Select Plan to Modify</label>
                    <select id="modal-plan-select" onchange="loadPlanIntoModal()"></select>
                </div>
                <button class="btn btn-danger" onclick="deleteCurrentPlan()" style="padding: 10px 14px; font-size: 0.85rem;" title="Delete Selected Plan">🗑️ Delete</button>
            </div>

            <!-- Export / Import Control Row -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; background: #0f172a; padding: 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                <div>
                    <label style="font-size:0.75rem; margin-bottom:4px;">Single Selected Plan</label>
                    <div style="display: flex; gap: 4px;">
                        <button class="btn btn-secondary" onclick="exportCurrentPlanJSON()" style="flex: 1; font-size: 0.75rem; padding: 6px;">📤 Export</button>
                        <button class="btn btn-secondary" onclick="document.getElementById('import-plan-file').click()" style="flex: 1; font-size: 0.75rem; padding: 6px;">📥 Import</button>
                    </div>
                </div>
                <div>
                    <label style="font-size:0.75rem; margin-bottom:4px;">All Compliance Plans</label>
                    <div style="display: flex; gap: 4px;">
                        <button class="btn btn-secondary" onclick="exportAllPlansJSON()" style="flex: 1; font-size: 0.75rem; padding: 6px;">📤 Export All</button>
                        <button class="btn btn-secondary" onclick="document.getElementById('import-all-plans-file').click()" style="flex: 1; font-size: 0.75rem; padding: 6px;">📥 Import All</button>
                    </div>
                </div>
            </div>
            <input type="file" id="import-plan-file" accept=".json" style="display:none;" onchange="importPlanJSON(event)">
            <input type="file" id="import-all-plans-file" accept=".json" style="display:none;" onchange="importAllPlansJSON(event)">

            <div class="form-group" style="margin-top: 16px;">
                <label>Plan Name</label>
                <input type="text" id="modal-plan-name">
            </div>

            <div style="display: flex; gap: 12px; margin-bottom: 16px;">
                <div class="form-group" style="flex: 1; margin-bottom:0;">
                    <label>Optimal Low (°F)</label>
                    <input type="number" step="0.1" id="modal-optimal-low">
                </div>
                <div class="form-group" style="flex: 1; margin-bottom:0;">
                    <label>Optimal High (°F)</label>
                    <input type="number" step="0.1" id="modal-optimal-high">
                </div>
            </div>

            <label>Excursion Tiers</label>
            <div id="modal-tiers-container"></div>
            
            <button class="btn btn-secondary" onclick="addModalTierRow()" style="width: 100%; margin-top: 8px; font-size: 0.8rem;">+ Add Excursion Tier</button>

            <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: flex-end;">
                <button class="btn btn-secondary" onclick="closePlanModal()">Cancel</button>
                <button class="btn" onclick="savePlanFromModal()">Save Plan Settings</button>
            </div>
        </div>
    </div>

    <!-- Modal Editor for Logger Profile Names -->
    <div class="modal-overlay" id="profile-modal">
        <div class="modal">
            <div class="modal-header">
                <h3>Edit Logger Profile Names</h3>
                <button onclick="closeProfileModal()" style="background:none; border:none; color: var(--text-main); font-size: 1.2rem; cursor:pointer;">✕</button>
            </div>
            <div class="form-group">
                <label>Customize display names for data logger hardware profiles</label>
                <div id="profile-names-container"></div>
            </div>
            <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: flex-end;">
                <button class="btn btn-secondary" onclick="closeProfileModal()">Cancel</button>
                <button class="btn" onclick="saveProfileNames()">Save Profile Names</button>
            </div>
        </div>
    </div>

    <script>
        // Baked-in Default Compliance Plans (QC Plan #7 MRB Chicken included as primary default)
        let compliancePlans = {
            mrb_chicken_7: {
                name: "QC Plan #7 MRB Chicken",
                optimalLow: -999.0,
                optimalHigh: 12.0,
                ranges: [
                    { low: 12.1, high: 999.9, allowed: 60, type: 'warm' }
                ]
            },
            frozen_qc_2: {
                name: "Frozen QC Plans 2",
                optimalLow: -25.0,
                optimalHigh: 25.0,
                ranges: [
                    { low: 25.1, high: 32.0, allowed: 2160, type: 'warm' },
                    { low: 32.1, high: 40.0, allowed: 1080, type: 'warm' },
                    { low: 40.1, high: 69.9, allowed: 720, type: 'warm' },
                    { low: 70.0, high: 999.9, allowed: 180, type: 'warm' }
                ]
            },
            cultured_dairy: {
                name: "Cultured Dairy Plan",
                optimalLow: 34.0,
                optimalHigh: 45.0,
                ranges: [
                    { low: 45.1, high: 50.0, allowed: 720, type: 'warm' },
                    { low: 50.1, high: 60.0, allowed: 240, type: 'warm' },
                    { low: 60.1, high: 999.9, allowed: 60, type: 'warm' }
                ]
            },
            standard_fresh: {
                name: "Standard Fresh Plan",
                optimalLow: 32.0,
                optimalHigh: 41.0,
                ranges: [
                    { low: -99.9, high: 31.9, allowed: 120, type: 'cold' },
                    { low: 41.1, high: 50.0, allowed: 360, type: 'warm' },
                    { low: 50.1, high: 999.9, allowed: 120, type: 'warm' }
                ]
            }
        };

        // Baked-in Default Logger Hardware Profiles
        let loggerProfiles = {
            auto: "Auto-Detect Profile",
            cargodata_lightning: "Cargo Data Lightning NFC (.xls/.xlsx)",
            temptale: "Sensitech TempTale Series",
            tive: "Tive Recorder (Celsius CSV)",
            cryopak: "CryoPAK Recorder (DD/MM/YY)",
            freshliance: "Freshliance Fresh Tag",
            copeland: "Copeland Data Logger",
            deltatrak: "DeltaTrak FlashLink",
            logtag: "LogTag Recorders",
            elpro_hobo: "Elpro / Onset HOBO"
        };

        let fullRawData = [];
        let filteredData = [];
        let activeFilename = "None";
        let lastEvaluationResult = null;

        let zoomState = {
            startTimeMs: null,
            endTimeMs: null,
            isDragging: false,
            dragStartX: 0,
            dragCurrentX: 0
        };

        let mouseState = {
            x: -1,
            y: -1,
            hovering: false
        };

        window.addEventListener('DOMContentLoaded', () => {
            loadSavedPlans();
            loadSavedProfiles();
            populatePlanDropdowns();
            populateProfileDropdown();
            initMinMaxInputs();
            initCanvasInteractiveEvents();
        });

        function loadSavedPlans() {
            const saved = localStorage.getItem('coldtrace_custom_plans');
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    if (parsed && typeof parsed === 'object' && Object.keys(parsed).length > 0) {
                        compliancePlans = { ...compliancePlans, ...parsed };
                    }
                } catch(e) {
                    console.error("Failed to parse custom plans", e);
                }
            }
        }

        function loadSavedProfiles() {
            const saved = localStorage.getItem('coldtrace_custom_profiles');
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    if (parsed && typeof parsed === 'object' && Object.keys(parsed).length > 0) {
                        loggerProfiles = { ...loggerProfiles, ...parsed };
                    }
                } catch(e) {
                    console.error("Failed to parse custom profiles", e);
                }
            }
        }

        function savePlansToStorage() {
            localStorage.setItem('coldtrace_custom_plans', JSON.stringify(compliancePlans));
        }

        function saveProfilesToStorage() {
            localStorage.setItem('coldtrace_custom_profiles', JSON.stringify(loggerProfiles));
        }

        function populatePlanDropdowns() {
            const select = document.getElementById('plan-select');
            const modalSelect = document.getElementById('modal-plan-select');
            if (!select || !modalSelect) return;

            const currentSelected = select.value;

            select.innerHTML = '';
            modalSelect.innerHTML = '';

            for (let key in compliancePlans) {
                let opt = document.createElement('option');
                opt.value = key;
                opt.innerText = compliancePlans[key].name;
                select.appendChild(opt);

                let optModal = document.createElement('option');
                optModal.value = key;
                optModal.innerText = compliancePlans[key].name;
                modalSelect.appendChild(optModal);
            }

            if (compliancePlans[currentSelected]) {
                select.value = currentSelected;
                modalSelect.value = currentSelected;
            } else {
                select.value = 'mrb_chicken_7';
                modalSelect.value = 'mrb_chicken_7';
            }
        }

        function populateProfileDropdown() {
            const select = document.getElementById('logger-profile-select');
            if (!select) return;

            const currentSelected = select.value;

            select.innerHTML = '';
            for (let key in loggerProfiles) {
                let opt = document.createElement('option');
                opt.value = key;
                opt.innerText = loggerProfiles[key];
                select.appendChild(opt);
            }

            if (loggerProfiles[currentSelected]) {
                select.value = currentSelected;
            } else {
